{
  "svgoConfig": {
    "plugins": [
      {
        "name": "preset-default",
        "params": {
          "overrides": {
            "inlineStyles": { "onlyMatchedOnce": false },
            "removeViewBox": false,
            "removeUnknownsAndDefaults": false,
            "convertColors": false
          }
        }
      },
      { "name": "removeAttrs", "params": { "attrs": "path:stroke-width" } }
    ]
  }
}
